{
  "name": "homework-copilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-tesseract-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-tesseract-assets.mjs && node scripts/check-build-env.mjs",
    "build": "npm run check:unicode && tsc -b && vite build && node scripts/create-static-routes.mjs",
    "check:unicode": "node scripts/check-mixed-alphabets.mjs",
    "assets:og": "node scripts/render-og-card.mjs",
    "promo:render": "node scripts/render-promo.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:legal-browser": "node scripts/verify-legal-browser.mjs",
    "test:referral-browser": "node scripts/verify-referral-browser.mjs",
    "test:admin-browser": "node scripts/verify-admin-browser.mjs",
    "test:visual": "playwright test",
    "preview": "vite preview",
    "test:e2e": "playwright test --grep-invert \"visual regression\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.112.3",
    "motion": "^13.1.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
