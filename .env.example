# --- Клиент (попадает в сборку) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Адреса функций на Vercel. Под GitHub Pages обязательны: без них клиент
# постучится в относительный путь и попадёт в заглушку Pages.
# Проверяет scripts/check-build-env.mjs, задаются в .github/workflows/deploy-pages.yml.
VITE_HOMEWORK_API_URL=
VITE_SUPPORT_API_URL=
VITE_CHAT_API_URL=
# Необязательные: без них адрес берётся из VITE_HOMEWORK_API_URL заменой
# `/solve` на `/payment`, `/admin`, `/auth-yandex`, а без него - `/api/...`.
# VITE_PAYMENT_API_URL=
# VITE_ADMIN_API_URL=
# VITE_YANDEX_AUTH_API_URL=

# --- Сервер (только Vercel и локальный запуск функций) ---
KIE_API_KEY=your_kie_ai_api_key
# Необязательно: одна модель на все вызовы вместо пула из
# server/geometrySolutionEngine.ts. Перебор семейств при этом отключается.
# KIE_MODEL=gemini-3-5-flash-openai
SUPABASE_SERVICE_ROLE_KEY=server_only_supabase_service_role_key
# Тот же ключ под новым именем: код принимает любое из двух.
# SUPABASE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=server_only_telegram_bot_token
TELEGRAM_OWNER_CHAT_ID=server_only_telegram_owner_chat_id
TELEGRAM_WEBHOOK_SECRET=server_only_webhook_secret
# Почтовые уведомления админки (server/admin.ts). Этот же ключ - SMTP-пароль
# писем авторизации в supabase/config.toml, `pass = "env(RESEND_API_KEY)"`.
RESEND_API_KEY=re_your_key
# Необязательно: отправитель. По умолчанию Homework Copilot <no-reply@homeworkcopilot.ru>.
# RESEND_FROM=
# Робокасса. Без логина и паролей того режима, в котором заводятся заказы,
# оплаты нет: форма пополнения не показывается. Пароли - из кабинета
# магазина, «Технические настройки»; у тестового режима своя пара.
# ROBOKASSA_MERCHANT_LOGIN=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=
# ROBOKASSA_TEST_PASSWORD1=
# ROBOKASSA_TEST_PASSWORD2=
# 1 - новые заказы идут в тестовый режим, оплату видят только служебные аккаунты.
# ROBOKASSA_TEST_MODE=1
# Алгоритм подписи из кабинета: md5 (по умолчанию), sha256, sha384, sha512.
# ROBOKASSA_HASH=md5
# 1 - чек НПД формирует Робокасса (Робочеки СМЗ): в ссылку на оплату уходят
# Receipt и почта аккаунта. Любое другое значение - ссылка как без чеков.
# Включать после подключения Робочеков, прав Robokassa в «Мой налог» и новой
# редакции оферты - порядок в AGENTS.md, «Оплата через Робокассу».
# ROBOKASSA_RECEIPTS=1
# Вход через Яндекс ID (AGENTS.md «Вход: почта, Яндекс ID, телефон»). Без
# трёх переменных вход не включается: сервер отвечает 503, кнопку прячет
# флаг auth_yandex в админке.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# Секрет подписи state, не короче 32 знаков: openssl rand -hex 32.
# AUTH_STATE_SECRET=
# Только если Redirect URI в приложении Яндекса другой.
# YANDEX_REDIRECT_URI=https://www.homeworkcopilot.ru/app
# Вход по номеру телефона: Send SMS hook Supabase шлёт код через SMS.ru.
# Секрет хука из Supabase (Authentication → Hooks), вида v1,whsec_...
# Его же читает `supabase config push`: [auth.hook.send_sms] в config.toml.
# SEND_SMS_HOOK_SECRET=
# SMSRU_API_ID=
# 1 - SMS.ru принимает запрос, но не отправляет СМС и не списывает деньги.
# SMSRU_TEST=1

# --- Supabase: секреты Edge-функции `api` (supabase/functions/api) ---
# Задаются `supabase secrets set`, не на Vercel. Ключ, которым прокси
# подписывает запрос к функциям на Vercel (`x-proxy-auth`); какое значение
# ждёт Vercel - в supabase/functions/api/index.ts. Не сошёлся - решатель
# видит `via: direct`, и лимит гостя считается по адресу прокси.
# HOMEWORK_PROXY_KEY=
