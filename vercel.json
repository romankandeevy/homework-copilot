{
  "functions": {
    "api/solve.ts": {
      "includeFiles": "{server/**,src/lib/**,src/textbooks/**}",
      "maxDuration": 300
    },
    "api/chat.ts": {
      "includeFiles": "{server/**,src/lib/**}",
      "maxDuration": 300
    },
    "api/support.ts": {
      "includeFiles": "{server/**,src/lib/**}",
      "maxDuration": 30
    },
    "api/telegram-webhook.ts": {
      "includeFiles": "{server/**,src/lib/**}",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "homeworkcopilot.ru"
        }
      ],
      "destination": "https://www.homeworkcopilot.ru/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "homeworkcopilot.ru"
        }
      ],
      "destination": "https://www.homeworkcopilot.ru/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.homeworkcopilot.ru"
        }
      ],
      "destination": "https://www.homeworkcopilot.ru/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "app.homeworkcopilot.ru"
        }
      ],
      "destination": "https://www.homeworkcopilot.ru/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "homework-copilot-taupe.vercel.app"
        }
      ],
      "destination": "https://www.homeworkcopilot.ru/",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "homework-copilot-taupe.vercel.app"
        }
      ],
      "destination": "https://www.homeworkcopilot.ru/:path",
      "permanent": false
    },
    {
      "source": "/main",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/base",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/tasks",
      "destination": "/cdz",
      "permanent": true
    },
    {
      "source": "/textbooks",
      "destination": "/cdz",
      "permanent": true
    },
    {
      "source": "/agreement",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://homework-copilot-taupe.vercel.app https://cdn.jsdelivr.net; font-src 'self' data:; form-action 'self'; frame-src https://accounts.google.com https://*.supabase.co; img-src 'self' data: blob: https://*.supabase.co; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob: frame-ancestors 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/support",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/schedule",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/solutions/:textbookId/:task",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|site.webmanifest|favicon.svg|og-card.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/solutions",
      "destination": "/index.html"
    },
    {
      "source": "/solutions/:textbookId/:task",
      "destination": "/index.html"
    },
    {
      "source": "/cdz",
      "destination": "/index.html"
    },
    {
      "source": "/base",
      "destination": "/index.html"
    },
    {
      "source": "/tasks",
      "destination": "/index.html"
    },
    {
      "source": "/textbooks",
      "destination": "/index.html"
    },
    {
      "source": "/schedule",
      "destination": "/index.html"
    },
    {
      "source": "/support",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/consent",
      "destination": "/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/index.html"
    },
    {
      "source": "/offer",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
