{
  "functions": {
    "api/solve.ts": {
      "includeFiles": "{server/**,src/lib/**,src/textbooks/**}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.homeworkcopilot.ru/",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "https://www.homeworkcopilot.ru/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/main", "destination": "/index.html" },
    { "source": "/solutions", "destination": "/index.html" },
    { "source": "/solutions/:textbookId/:task", "destination": "/index.html" },
    { "source": "/cdz", "destination": "/index.html" },
    { "source": "/base", "destination": "/index.html" },
    { "source": "/tasks", "destination": "/index.html" },
    { "source": "/textbooks", "destination": "/index.html" },
    { "source": "/schedule", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ]
}
