{
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.homeworkcopilot.ru/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://www.homeworkcopilot.ru/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ]
}
